{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ui/src",
  "prefix": "el",
  "projectType": "library",
  "tags": ["scope:ui", "type:lib", "platform:web"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "stylelint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "stylelint \"packages/ui/src/**/*.scss\" --config packages/ui/.stylelintrc.json --allow-empty-input"
      }
    }
  }
}
