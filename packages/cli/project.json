{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/cli/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["scope:cli", "type:lib", "platform:node", "publish:npm"],
  "implicitDependencies": ["ui"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/cli",
        "main": "packages/cli/src/index.ts",
        "outputFileName": "index.cjs",
        "tsConfig": "packages/cli/tsconfig.lib.json",
        "platform": "node",
        "format": ["cjs"],
        "assets": [
          {
            "glob": "package.json",
            "input": "packages/cli",
            "output": "."
          },
          {
            "glob": "README.md",
            "input": "packages/cli",
            "output": "."
          },
          {
            "glob": "icon.{ts,scss}",
            "input": "packages/ui/src/lib/icon",
            "output": "registry/icon"
          },
          {
            "glob": "fontawesome.scss",
            "input": "packages/ui/src/lib/icon",
            "output": "registry/icon"
          },
          {
            "glob": "button.{ts,html,scss}",
            "input": "packages/ui/src/lib/button",
            "output": "registry/button"
          },
          {
            "glob": "label.{ts,html,scss}",
            "input": "packages/ui/src/lib/label",
            "output": "registry/label"
          },
          {
            "glob": "form-error.{ts,html,scss}",
            "input": "packages/ui/src/lib/form-error",
            "output": "registry/form-error"
          },
          {
            "glob": "input.{ts,html,scss}",
            "input": "packages/ui/src/lib/input",
            "output": "registry/input"
          },
          {
            "glob": "checkbox.{ts,html,scss}",
            "input": "packages/ui/src/lib/checkbox",
            "output": "registry/checkbox"
          },
          {
            "glob": "slide-toggle.{ts,html,scss}",
            "input": "packages/ui/src/lib/slide-toggle",
            "output": "registry/slide-toggle"
          },
          {
            "glob": "radio.{ts,html,scss}",
            "input": "packages/ui/src/lib/radio",
            "output": "registry/radio"
          },
          {
            "glob": "radio-group.{ts,html,scss}",
            "input": "packages/ui/src/lib/radio",
            "output": "registry/radio"
          },
          {
            "glob": "radio.token.ts",
            "input": "packages/ui/src/lib/radio",
            "output": "registry/radio"
          },
          {
            "glob": "select.{ts,html,scss}",
            "input": "packages/ui/src/lib/select",
            "output": "registry/select"
          },
          {
            "glob": "select-item.{ts,html,scss}",
            "input": "packages/ui/src/lib/select",
            "output": "registry/select"
          },
          {
            "glob": "select-group.{ts,html,scss}",
            "input": "packages/ui/src/lib/select",
            "output": "registry/select"
          },
          {
            "glob": "select-value.ts",
            "input": "packages/ui/src/lib/select",
            "output": "registry/select"
          },
          {
            "glob": "select.token.ts",
            "input": "packages/ui/src/lib/select",
            "output": "registry/select"
          },
          {
            "glob": "chip.{ts,html,scss}",
            "input": "packages/ui/src/lib/chip",
            "output": "registry/chip"
          },
          {
            "glob": "segmented-button.{ts,html,scss}",
            "input": "packages/ui/src/lib/segmented-button",
            "output": "registry/segmented-button"
          },
          {
            "glob": "segmented-button-item.{ts,html,scss}",
            "input": "packages/ui/src/lib/segmented-button",
            "output": "registry/segmented-button"
          },
          {
            "glob": "segmented-button.token.ts",
            "input": "packages/ui/src/lib/segmented-button",
            "output": "registry/segmented-button"
          },
          {
            "glob": "date.ts",
            "input": "packages/ui/src/lib/datepicker",
            "output": "registry/datepicker"
          },
          {
            "glob": "calendar.{ts,html,scss}",
            "input": "packages/ui/src/lib/datepicker",
            "output": "registry/datepicker"
          },
          {
            "glob": "clock.{ts,html,scss}",
            "input": "packages/ui/src/lib/datepicker",
            "output": "registry/datepicker"
          },
          {
            "glob": "date-fields.{ts,html,scss}",
            "input": "packages/ui/src/lib/datepicker",
            "output": "registry/datepicker"
          },
          {
            "glob": "date-picker.{ts,html,scss}",
            "input": "packages/ui/src/lib/datepicker",
            "output": "registry/datepicker"
          },
          {
            "glob": "date-range-picker.{ts,html,scss}",
            "input": "packages/ui/src/lib/datepicker",
            "output": "registry/datepicker"
          },
          {
            "glob": "theme.ts",
            "input": "packages/ui/src/lib/theme",
            "output": "registry/theme"
          },
          {
            "glob": "theme.token.ts",
            "input": "packages/ui/src/lib/theme",
            "output": "registry/theme"
          },
          {
            "glob": "tokens.scss",
            "input": "packages/ui/src/lib/theme",
            "output": "registry/theme"
          },
          {
            "glob": "fonts.scss",
            "input": "packages/ui/src/lib/theme",
            "output": "registry/theme"
          },
          {
            "glob": "geist-latin-wght-normal.woff2",
            "input": "packages/ui/src/lib/theme",
            "output": "registry/theme"
          },
          {
            "glob": "geist-mono-latin-wght-normal.woff2",
            "input": "packages/ui/src/lib/theme",
            "output": "registry/theme"
          }
        ],
        "esbuildOptions": {
          "banner": {
            "js": "#!/usr/bin/env node"
          }
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "dependsOn": ["build"]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
